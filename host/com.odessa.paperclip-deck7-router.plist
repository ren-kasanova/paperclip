<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.odessa.paperclip-deck7-router</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/node@22/bin/node</string>
    <string>/Users/ren/.paperclip-deck7-router/paperclip-deck7-router.mjs</string>
    <string>--once</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ren/.paperclip-deck7-router</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PAPERCLIP_DECK7_API_BASE</key>
    <string>http://127.0.0.1:3100/api</string>
    <key>PAPERCLIP_DECK7_STATE_DIR</key>
    <string>/Users/ren/.paperclip-deck7-router</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>15</integer>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/Users/ren/.paperclip-deck7-router/router.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ren/.paperclip-deck7-router/router.log</string>
</dict>
</plist>
